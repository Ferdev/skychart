{
  "name": "cosmic-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "bash scripts/dev.sh",
    "build": "tsc && vite build",
    "build:phoenix": "tsc && vite build --outDir backend_phoenix/priv/static --emptyOutDir false",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test --project=smoke",
    "test:perf": "playwright test --project=perf"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.10"
  }
}
